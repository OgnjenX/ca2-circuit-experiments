{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "development",
      "displayName": "Local development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++-12",
        "CA2_BUILD_MODELS": true,
        "Python3_EXECUTABLE": "${sourceDir}/.venv/bin/python"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "development",
      "configurePreset": "development",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "development",
      "configurePreset": "development",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
