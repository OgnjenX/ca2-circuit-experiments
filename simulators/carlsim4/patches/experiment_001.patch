+#include <cstdlib>
+struct StopWatchInterface {
+ std::chrono::steady_clock::time_point start;
+ float elapsed = 0;
+};
+inline void ca2CudaCheck(cudaError_t err, const char* expression, const char* file, int line) {
+ if(err != cudaSuccess) { std::fprintf(stderr,"CUDA error %s:%d: %s: %s\n",file,line,expression,cudaGetErrorString(err)); std::exit(1); }
+}
+inline int ca2BestDevice() {
+ int count=0, best=0; long long score=-1;
+ ca2CudaCheck(cudaGetDeviceCount(&count),"cudaGetDeviceCount",__FILE__,__LINE__);
+ for(int i=0;i<count;++i) { cudaDeviceProp prop; ca2CudaCheck(cudaGetDeviceProperties(&prop,i),"cudaGetDeviceProperties",__FILE__,__LINE__); long long current=(long long)prop.multiProcessorCount*prop.clockRate; if(current>score){score=current;best=i;} }
+ return best;
+}
